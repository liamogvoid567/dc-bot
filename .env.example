# Discord Bot Token
# Wo du den Token findest:
# 1. Gehe zu https://discord.com/developers/applications
# 2. Erstelle eine neue Application oder öffne eine existierende
# 3. Gehe zum "Bot" Tab
# 4. Klicke auf "Reset Token" oder kopiere den existierenden Token
DISCORD_TOKEN=dein_bot_token_hier

# Bot Präfix (optional, für Textbefehle)
BOT_PREFIX=!

# Ticket Log Channel ID
# Wo du die Channel ID findest:
# 1. Aktiviere Developer Mode in Discord (Einstellungen > Erweitert > Entwicklermodus)
# 2. Rechtsklick auf den Channel > "Channel-ID kopieren"
LOG_CHANNEL_ID=deine_log_channel_id

# Support Rollen ID
# Wo du die Rollen ID findest:
# 1. Aktiviere Developer Mode (siehe oben)
# 2. Rechtsklick auf die Rolle in den Servereinstellungen > Rollen > "Rollen-ID kopieren"
SUPPORT_ROLE_ID=deine_support_role_id

# Ticket Kategorie ID
# Wo du die Kategorie ID findest:
# 1. Aktiviere Developer Mode (siehe oben)
# 2. Rechtsklick auf die Kategorie > "Kategorie-ID kopieren"
TICKET_CATEGORY_ID=deine_ticket_kategorie_id
